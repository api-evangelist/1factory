  "item": [
    {
      "id": "b35eba3d-03e7-45d7-b43f-b973b5ae15eb",
      "name": "Work Orders",
      "description": {
        "content": "Work Orders define a list of current work order primary & secondary identifiers that may be used as identifiers on Inspections & FAIs.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c5b28b26-f99a-4d05-ba7d-4aaccf67a721",
          "name": "1Factory Updates the List of Manufacturing Work Order Numbers for Your Organization.",
          "request": {
            "name": "1Factory Updates the List of Manufacturing Work Order Numbers for Your Organization.",
            "description": {
              "content": "Defines the current list of manufacturing work orders for your organization. If a work order list already exists, this request will overwrite it.\n\nThis list will be used to provide suggested values for manufacturing inspection identifiers in the 1Factory application, for example, when creating a new inspection. \n\nIt will also pre-populate the lot size for inspections created using an inspection identifier in this list, if the corresponding list entry has a lot size. \n\nNote that the names used to refer to inspection identifiers in the 1Factory application will depend on what is configured for Mfg. Insp. Ident. in your organization's settings page.\n\nThe combination of insp_ident1 and insp_ident2 uniquely identifies each work order. An error will be returned if the list contains duplicate entries.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "mfg",
                "workOrderList"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lot_size\": \"<integer>\"\n  },\n  {\n    \"insp_ident_1\": \"<string>\",\n    \"insp_ident_2\": \"<string>\",\n    \"lo