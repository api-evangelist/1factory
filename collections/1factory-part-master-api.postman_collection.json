          "request": {
            "name": "1Factory Gets a List of Part Masters for Your Organization.",
            "description": {
              "content": "The list of part master entries that can be filtered by specifying query parameters. \n Paging parameters control the number of rows of part master objects returned. By default, the first 100 part masters are returned.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "partMasters"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "Starting page for queried rows - defaults to 0 (the start of the list). Returned rows will start at index (page * page_size)."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "100",
                  "description": "The maximum number of records to return from the query. Defaults to 100, maximum value 500."
                },
                {
                  "disabled": false,
                  "key": "part_number",
                  "value": "<string>",
                  "description": "Part name / number to filter on."
